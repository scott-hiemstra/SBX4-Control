# Build environment for the .rpm: Fedora 43 is the oldest supported Fedora, so
# packages built here also install on newer releases.
FROM fedora:43
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc pkgconf-pkg-config curl rpm-build \
        gtk4-devel libadwaita-devel alsa-lib-devel \
    && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rX /opt/rustup /opt/cargo
